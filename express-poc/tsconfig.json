{
  "compilerOptions": {
    "incremental": true,
    "target": "ES2020",
    "module": "nodenext",
    "moduleResolution": "node",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "alwaysStrict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "generated"],
  "exclude": ["node_modules", "dist"]
}
